{
  "name": "obsidian-youtube",
  "version": "0.4.0",
  "description": "Ad-free YouTube players, title lookup, search, and offline saving for Obsidian notes, ported from Starnote.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "keywords": ["obsidian", "youtube", "yt-dlp"],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
