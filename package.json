{
  "name": "obsidian-youtube",
  "version": "0.6.1",
  "description": "A native YouTube player, search panel, and offline copies for Obsidian notes, with a built-in stream engine. Ported from Starnote.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test tests/",
    "test:live": "node scripts/live-check.mjs"
  },
  "keywords": [
    "obsidian",
    "youtube",
    "yt-dlp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  },
  "author": "encomjp",
  "dependencies": {
    "youtubei.js": "^18.1.0"
  }
}
